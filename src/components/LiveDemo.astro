---
// "Try it live": the visitor pastes one link and gets the first results from a real run (POST /api/demo on our own
// Worker: Turnstile + limits + cache; the Worker holds the run-only token). Results show as Cards (photo, price,
// title, text, facts: chosen per actor from its dataset schema), Table or JSON, with JSON/CSV downloads.
import '@fontsource/caveat/600.css';
import { site } from '../lib/site.js';
// soon: actors shown as "coming soon" chips (home page). Empty on actor pages.
const { actor, others = [], soon = [], title = 'Try it live' } = Astro.props;
const d = actor.liveDemo;
const evs = (actor.facts.pricing.events || []).filter((e) => !e.oneTime);
const main = evs.find((e) => e.primary) || evs[0];
const ACCENT = { 'idealista-scraper-api': '#d3ef24', 'idealista-scraper': '#d3ef24', 'zillow-scraper': '#006aff', 'facebook-comment-scraper': '#1877f2', 'instagram-comment-scraper': '#e1306c', 'google-flights-scraper': '#4285f4', 'etsy-product-reviews-scraper': '#f1641e', 'youtube-transcript-metadata-extractor': '#ff0000' };
const accent = d.accent || ACCENT[actor.slug] || '#5bb5b5';
// Apify free plan: $5 credit per month → about how many results of the actor's main per-result event
const freeOf = (a) => { const ev = (a.facts.pricing.events || []).filter((e) => !e.oneTime); const m = ev.find((e) => e.primary) || ev[0]; return m && m.priceFreePlanUsd ? Math.floor(5 / m.priceFreePlanUsd) : null; };
const freeResults = freeOf(actor);
const lives = [actor, ...others];
---
<section class="explorer live-demo" id="try" aria-labelledby="try-h" data-demo-actor={d.actor} data-accent={accent} style={`--demo-accent:${accent}`}>
  <div class="explorer-head">
    <h2 id="try-h">{title}</h2>
    <span class="live"><i></i>runs for real · first page only, up to 10 results</span>
  </div>
  {(soon.length > 0 || others.length > 0) && (
    <div class="demo-picker" role="group" aria-label="Scraper">
      {lives.map((x, i) => <button type="button" class="pick" aria-pressed={String(i === 0)} data-pick="live" data-demo-id={x.liveDemo.actor} data-sample={x.liveDemo.sample} data-hint={x.liveDemo.hint} data-label={x.liveDemo.label} data-go={x.goUrl} data-name={x.label} data-src={x.source} data-free={freeOf(x) ? freeOf(x).toLocaleString('en') : ''} data-accent={x.liveDemo.accent || ACCENT[x.slug] || '#5bb5b5'}>{x.facts.icon && <img src={x.facts.icon} alt="" width="26" height="26" />}{x.liveDemo.chip || x.source}</button>)}
      {soon.map((s) => <button type="button" class="pick" aria-pressed="false" data-pick="soon" data-accent={ACCENT[s.slug] || "#5bb5b5"} data-name={s.label} data-url={s.url} data-icon={s.facts.icon || ''}>{s.facts.icon && <img src={s.facts.icon} alt="" width="26" height="26" loading="lazy" />}{s.source}<span class="soon">soon</span></button>)}
    </div>
  )}
  <div class="soonbox" data-soon hidden>
    <img data-soon-icon alt="" width="64" height="64" />
    <h3 data-soon-name></h3>
    <p class="muted small">Coming soon to the live demo. Its page shows every field it returns and the exact price.</p>
    <a class="btn btn-ghost" data-soon-link href="#">Open its page →</a>
  </div>
  <div data-live-part>
    <p class="muted small" data-hint>{d.hint}</p>
    <div class="demo-note" aria-hidden="true"><span>Paste any <span data-note-src>{actor.source}</span> link and hit Run:<br>real data in seconds</span><svg viewBox="0 0 120 70" width="110" height="64"><path d="M6 10 C 40 4, 86 14, 104 52" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/><path d="M92 46 L105 56 L108 40" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
    <form class="explorer-tools demo-form" data-demo-form>
      <input type="url" name="url" required value={d.sample} aria-label={d.label} spellcheck="false" />
      <button class="btn btn-primary demo-run" type="submit" data-demo-run>▶ Run it live</button>
    </form>
    <div class="cf-turnstile" data-sitekey={site.turnstileSiteKey} data-size="flexible" data-appearance="always" data-callback="feDemoToken" data-error-callback="feDemoError" data-expired-callback="feDemoExpired"></div>
    <p class="demo-quota"><b data-quota>🎁 20 free live runs per day</b><span>same link again = instant answer</span></p>
    <p class="demo-more">Need more? <a href={actor.goUrl} data-go-link rel="nofollow" target="_blank">Run it on your own free Apify account →</a> $5 of credit every month<span data-free-line>{freeResults ? <>, about <span data-free>{freeResults.toLocaleString('en')}</span> results</> : null}</span>, no daily limit.</p>
    <p class="demo-status" data-demo-status aria-live="polite"></p>
    <div class="demo-results" data-demo-results hidden>
      <div class="demo-bar">
        <div class="demo-views" role="tablist" aria-label="View">
          <button type="button" role="tab" aria-selected="true" data-view="cards">Cards</button>
          <button type="button" role="tab" aria-selected="false" data-view="table">Table</button>
          <button type="button" role="tab" aria-selected="false" data-view="json">JSON</button>
        </div>
        <div class="demo-dl"><button type="button" class="btn btn-ghost btn-sm" data-dl="json">⬇ JSON</button><button type="button" class="btn btn-ghost btn-sm" data-dl="csv">⬇ CSV</button></div>
      </div>
      <div class="demo-cards" data-pane="cards"></div>
      <div class="table-wrap" data-pane="table" hidden><table><thead></thead><tbody></tbody></table></div>
      <pre class="json demo-json" data-pane="json" hidden></pre>
      
    </div>
    <div class="demo-signup" data-signup hidden>
      <div>
        <strong data-signup-title>Want all of them?</strong>
        <p class="small" style="margin:4px 0 0">Create a free Apify account and run <b data-actor-label>{actor.label}</b> yourself. The free plan includes <b>$5 of credit every month</b>{freeResults ? <>, enough for about <b>{freeResults.toLocaleString('en')} results</b></> : null}. No card needed to start.</p>
      </div>
      <a class="btn btn-primary" href={actor.goUrl} data-go-link rel="nofollow" target="_blank">Run it on Apify, free →</a>
    </div>
  </div>
</section>
<script is:inline>
  // Turnstile callbacks (global names required by the widget attributes)
  window.feDemo = { token: '', error: '' };
  window.feDemoToken = (t) => { window.feDemo.token = t; window.feDemo.error = ''; };
  window.feDemoError = (code) => { window.feDemo.error = String(code || 'unknown'); return true; };
  window.feDemoExpired = () => { window.feDemo.token = ''; };
</script>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
  const box = document.querySelector('[data-demo-actor]');
  if (box) {
    const $ = (s) => box.querySelector(s);
    const form = $('[data-demo-form]'), status = $('[data-demo-status]'), run = $('[data-demo-run]');
    const results = $('[data-demo-results]'), cardsPane = $('[data-pane="cards"]'), tablePane = $('[data-pane="table"]'), jsonPane = $('[data-pane="json"]');
    let last = null;
    const esc = (v) => String(v ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

    // "coming soon" chips (home page)
    const livePart = $('[data-live-part]'), soonBox = $('[data-soon]');
    box.querySelectorAll('.pick').forEach((b) => b.addEventListener('click', () => {
      box.querySelectorAll('.pick').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      const live = b.dataset.pick === 'live';
      if (b.dataset.accent) box.style.setProperty('--demo-accent', b.dataset.accent);
      livePart.hidden = !live; soonBox.hidden = live;
      if (live && b.dataset.demoId) {
        box.dataset.demoActor = b.dataset.demoId;
        form.url.value = b.dataset.sample || '';
        form.url.setAttribute('aria-label', b.dataset.label || 'Link');
        $('[data-hint]').textContent = b.dataset.hint || '';
        $('[data-note-src]').textContent = b.dataset.src || '';
        box.querySelectorAll('[data-go-link]').forEach((a) => { a.href = b.dataset.go; });
        box.querySelectorAll('[data-actor-label]').forEach((el) => { el.textContent = b.dataset.name; });
        box.querySelectorAll('[data-free]').forEach((el) => { el.textContent = b.dataset.free; });
        box.querySelectorAll('[data-free-line]').forEach((el) => { el.hidden = !b.dataset.free; });
        results.hidden = true; $('[data-signup]').hidden = true; status.textContent = ''; last = null;
      }
      if (!live) {
        soonBox.querySelector('[data-soon-name]').textContent = b.dataset.name;
        soonBox.querySelector('[data-soon-link]').href = b.dataset.url;
        const img = soonBox.querySelector('[data-soon-icon]');
        img.hidden = !b.dataset.icon; if (b.dataset.icon) img.src = b.dataset.icon;
      }
    }));

    // view tabs
    box.querySelectorAll('[data-view]').forEach((t) => t.addEventListener('click', () => {
      box.querySelectorAll('[data-view]').forEach((x) => x.setAttribute('aria-selected', String(x === t)));
      for (const p of ['cards', 'table', 'json']) $(`[data-pane="${p}"]`).hidden = p !== t.dataset.view;
    }));

    // downloads (the rows already on screen; nothing is fetched again)
    const save = (name, type, text) => { const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([text], { type })); a.download = name; a.click(); setTimeout(() => URL.revokeObjectURL(a.href), 1000); };
    const toCsv = (rows) => { const cols = [...new Set(rows.flatMap((r) => Object.keys(r)))]; const q = (v) => { const s = String(v ?? ''); return /[",\n]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s; }; return '﻿' + [cols.join(','), ...rows.map((r) => cols.map((c) => q(r[c])).join(','))].join('\r\n'); };
    box.querySelectorAll('[data-dl]').forEach((b) => b.addEventListener('click', () => {
      if (!last) return;
      const base = `${box.dataset.demoActor}-live-demo`;
      if (b.dataset.dl === 'json') save(`${base}.json`, 'application/json', JSON.stringify(last.rows, null, 2));
      else save(`${base}.csv`, 'text/csv;charset=utf-8', toCsv(last.rows));
    }));

    const money = (n, cur) => { const x = Number(n); return Number.isFinite(x) ? new Intl.NumberFormat('en', { style: 'currency', currency: cur || 'EUR', maximumFractionDigits: 0 }).format(x) : esc(n); };
    function render(data) {
      const d = data.display || {};
      cardsPane.innerHTML = data.rows.map((r) => `
        <article class="demo-card">
          ${d.image && r[d.image] ? `<img src="${esc(r[d.image])}" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.remove()">` : ''}
          <div class="demo-card-body">
            ${d.price && r[d.price] !== undefined ? `<div class="demo-price">${money(r[d.price], d.currency)}</div>` : ''}
            ${d.title && r[d.title] ? `<h3>${esc(r[d.title])}</h3>` : ''}
            <div class="demo-facts">${(d.facts || []).filter(([k]) => r[k] !== undefined && r[k] !== '').map(([k, label]) => `<span>${esc(r[k])}${label ? ' ' + esc(label) : ''}</span>`).join('')}</div>
            ${d.text && r[d.text] ? `<p>${esc(r[d.text])}</p>` : ''}
            ${d.link && r[d.link] ? `<a href="${esc(r[d.link])}" rel="nofollow noopener" target="_blank">View the listing ↗</a>` : ''}
          </div>
        </article>`).join('');
      const cols = [...new Set(data.rows.flatMap((r) => Object.keys(r)))].filter((c) => c !== d.text && c !== d.image);
      tablePane.querySelector('thead').innerHTML = '<tr>' + cols.map((c) => `<th>${esc(c.replace(/_/g, ' '))}</th>`).join('') + '</tr>';
      tablePane.querySelector('tbody').innerHTML = data.rows.map((r) => '<tr>' + cols.map((c) => `<td>${esc(r[c])}</td>`).join('') + '</tr>').join('');
      jsonPane.textContent = JSON.stringify(data.rows, null, 2);
      results.hidden = false;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      run.disabled = true;
      const t0 = Date.now();
      const tick = setInterval(() => { status.textContent = `Running on the live site… ${Math.round((Date.now() - t0) / 1000)} s`; }, 500);
      // wait up to 6 s for the human check; if it fails or never arrives, send without a token (the server decides)
      window.feDemo.error = '';
      if (!window.feDemo.token) status.textContent = "Checking you are human…";
      for (let i = 0; i < 50 && !window.feDemo.token && !window.feDemo.error; i++) await new Promise((r) => setTimeout(r, 500));
      try {
        const r = await fetch('/api/demo', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ actor: box.dataset.demoActor, url: form.url.value.trim(), turnstile: window.feDemo.token || '' }) });
        const data = await r.json();
        const quota = $('[data-quota]');
        if (typeof data.remaining === 'number' && data.limits) quota.textContent = data.remaining > 0 ? `🎁 ${data.remaining} of ${data.limits.day} free runs left today` : `🎁 No free runs left (${data.limits.day} per day, ${data.limits.hour} per hour)`;
        const signup = $('[data-signup]'), sTitle = $('[data-signup-title]');
        if (!r.ok) {
          if (data.signup) { sTitle.textContent = 'Keep going on your own account'; signup.hidden = false; }
          status.textContent = (data.error || 'No results for this link.') + (window.feDemo.error ? ` (human check error ${window.feDemo.error})` : '');
          return;
        }
        last = data; render(data);
        sTitle.textContent = data.total ? `This search has ${Number(data.total).toLocaleString('en')} results. You saw ${data.count}.` : 'Want all of them?';
        signup.hidden = false;
        status.textContent = `${data.count} results in ${(data.ms / 1000).toFixed(1)} s${data.cached ? ' (from the last 24 h)' : ''}${data.total ? ` · this search has ${Number(data.total).toLocaleString('en')} listings; the demo shows the first ${data.count}` : ''}.`;
      } catch { status.textContent = 'The demo did not answer. Try again in a minute.'; }
      finally {
        clearInterval(tick); run.disabled = false;
        window.feDemo.token = ''; try { window.turnstile?.reset(); } catch {}
      }
    });
  }
</script>
