---
// Home-page demo: every actor with a real sample and a "demo" block is rendered here (crawlable HTML, each with a
// link to its page). A small script picks 4 at random per visit, builds the tabs with the actor icons, types the
// JSON in and rotates. Without JS the first one shows. Values come from data/samples/<slug>/sample.json (real runs).
import ActorIcon from './ActorIcon.astro';
import { blurb, priceShort } from '../lib/site.js';
const { pool } = Astro.props;
const rowFor = (a) => {
  const rows = a.demo.type ? a.sample.rows.filter((r) => r.record_type === a.demo.type) : a.sample.rows;
  return rows[a.demo.row || 0] || rows[0];
};
const fmt = (v) => (typeof v === 'string' ? JSON.stringify(v.length > 60 ? v.slice(0, 57) + '…' : v) : JSON.stringify(v));
---
<div class="machine" data-demo aria-label="Real results from our scrapers">
  <div class="demo-tabs" role="tablist" aria-label="Example scrapers" data-demo-tabs></div>
  {pool.map((a, i) => {
    const row = rowFor(a);
    const fields = a.demo.fields.filter((f) => row[f] !== undefined && row[f] !== null);
    return (
      <div class="demo-item" id={`demo-${a.pageSlug}`} data-label={a.demo.tab || a.source} data-icon={a.facts.icon || ''} hidden={i > 0} role="tabpanel">
        <div class="win">
          <div class="win-bar"><i></i><i></i><i></i><span class="url">{a.demo.url}</span></div>
          <div class="win-body">
            <ActorIcon a={a} size={64} class="thumb" />
            <div>
              <h3><a href={a.url}>{a.label}</a></h3>
              <p>{blurb(a)}</p>
              <div class="meta"><span class="price">{priceShort(a)}</span><span class="live"><i></i>real run · {a.sample.run.date}</span></div>
            </div>
          </div>
        </div>
        <div class="flow">
          <svg class="drops" viewBox="0 0 300 76" preserveAspectRatio="none" aria-hidden="true"><path d="M150 0 V76" stroke="#d8e7e4" stroke-width="2" fill="none" stroke-dasharray="3 6" /></svg>
          <svg class="core" viewBox="0 0 60 60" aria-hidden="true"><path d="M30 10 L12 46 L48 46 Z" fill="none" stroke="#5bb5b5" stroke-width="3" /><circle class="n" cx="30" cy="10" r="8" fill="#2d4a4a" /><circle class="n" cx="12" cy="46" r="8" fill="#2d4a4a" /><circle class="n" cx="48" cy="46" r="8" fill="#2d4a4a" /></svg>
        </div>
        <div class="json">
          <div class="line on"><span class="p">{'{'}</span></div>
          {fields.map((f, n) => (
            <div class="line">&nbsp;&nbsp;<span class="k">"{f}"</span><span class="p">: </span><span class={typeof row[f] === 'string' ? 's' : 'v'}>{fmt(row[f])}</span>{n < fields.length - 1 ? <span class="p">,</span> : null}</div>
          ))}
          <div class="line"><span class="p">{'}'}</span></div>
        </div>
        <div class="demo-foot"><span>One real row of {a.sample.run.itemCount} from that run</span><a href={a.url}>All fields and the price →</a></div>
      </div>
    );
  })}
</div>
<script>
  const box = document.querySelector('[data-demo]');
  if (box) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const all = [...box.querySelectorAll('.demo-item')];
    const picked = all.map((el) => [Math.random(), el]).sort((x, y) => x[0] - y[0]).slice(0, 4).map((p) => p[1]);
    const tabs = box.querySelector('[data-demo-tabs]');
    let cur = 0, rotate = null, typing = [], dropTimer = null;
    picked.forEach((el, i) => {
      const b = document.createElement('button');
      b.className = 'demo-tab'; b.type = 'button'; b.setAttribute('role', 'tab'); b.setAttribute('aria-controls', el.id);
      if (el.dataset.icon) { const img = document.createElement('img'); img.src = el.dataset.icon; img.alt = ''; b.append(img); }
      b.append(el.dataset.label);
      b.addEventListener('click', () => { show(i); restart(); });
      tabs.append(b);
    });
    function show(i) {
      cur = i;
      typing.forEach(clearTimeout); typing = [];
      all.forEach((el) => (el.hidden = el !== picked[i]));
      tabs.querySelectorAll('.demo-tab').forEach((t, n) => t.setAttribute('aria-selected', String(n === i)));
      const el = picked[i];
      const thumb = el.querySelector('.thumb');
      if (thumb) { thumb.style.animation = 'none'; void thumb.offsetWidth; thumb.style.animation = ''; }
      const lines = [...el.querySelectorAll('.json .line')];
      lines.forEach((l, n) => { if (n > 0) l.classList.remove('on'); });
      lines.slice(1).forEach((l, n) => typing.push(setTimeout(() => l.classList.add('on'), reduce ? 0 : 350 + n * 300)));
      clearInterval(dropTimer);
      if (!reduce) {
        const svg = el.querySelector('.drops');
        dropTimer = setInterval(() => {
          const c = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
          c.setAttribute('r', '3.2'); c.setAttribute('cx', '150'); c.setAttribute('cy', '0');
          c.setAttribute('fill', ['#5bb5b5', '#7fd4d4', '#3a9494'][Math.floor(Math.random() * 3)]);
          c.innerHTML = '<animate attributeName="cy" from="0" to="76" dur="1.1s" fill="freeze"/><animate attributeName="opacity" values="0;1;1;0" dur="1.1s" fill="freeze"/>';
          svg.append(c); setTimeout(() => c.remove(), 1200);
        }, 420);
      }
    }
    function restart() {
      clearInterval(rotate);
      if (!reduce) rotate = setInterval(() => show((cur + 1) % picked.length), 7000);
    }
    box.addEventListener('mouseenter', () => clearInterval(rotate));
    box.addEventListener('mouseleave', restart);
    show(0); restart();
  }
</script>
