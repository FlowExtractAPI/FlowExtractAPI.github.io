---
import '@fontsource/outfit/600.css';
import '@fontsource/outfit/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/site.css';
import Logo from '../components/Logo.astro';
import { site, BASE, categoryIds, categoryHub, breadcrumbJsonLd, actors } from '../lib/site.js';

const { title, description, path, jsonLd = [], breadcrumbs = null, noindex = false } = Astro.props;
const canonical = BASE + path;
const year = new Date().getFullYear();
const ld = breadcrumbs ? [breadcrumbJsonLd(breadcrumbs), ...jsonLd] : jsonLd;
const s = site.social;
// Cloudflare Web Analytics token: site/.env PUBLIC_CF_WEB_ANALYTICS_TOKEN (see .env.example), else content/site.json
const waToken = import.meta.env.PUBLIC_CF_WEB_ANALYTICS_TOKEN || site.webAnalyticsToken || '';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="theme-color" content="#f7fbfa" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
    {/* Cloudflare Web Analytics (page views, referrers, countries, speed; no cookies). Token = waToken above, public by design. */}
    {waToken && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: waToken })}></script>}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-row">
        <a class="brand" href="/" aria-label="FlowExtract API home"><Logo /><span class="word">FlowExtract <b>API</b></span></a>
        <nav class="top-nav" aria-label="Main">
          <a href="/#actors">Scrapers</a>
          <a href="/about.html">About</a>
          <a href="/contact.html">Contact</a>
          <a class="btn btn-primary btn-sm" href="/#actors"><span class="long">Browse {actors.length} scrapers</span><span class="short">Scrapers</span></a>
        </nav>
      </div>
    </header>
    {breadcrumbs && !Astro.props.hideCrumbs && (
      <nav class="wrap crumbs" aria-label="Breadcrumb">
        <ol>{breadcrumbs.map((b, i) => <li>{i < breadcrumbs.length - 1 ? <a href={b.url}>{b.name}</a> : <span aria-current="page">{b.name}</span>}</li>)}</ol>
      </nav>
    )}
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <a class="brand" href="/" aria-label="FlowExtract API home"><Logo size={34} /><span class="word">FlowExtract <b>API</b></span></a>
            <p style="margin-top:12px;opacity:.85">Ready-to-run scrapers and data extraction APIs on the Apify platform. Pay only for the results you get.</p>
          </div>
          <div>
            <h2 class="footer-h">Scrapers</h2>
            <ul class="footer-list">{categoryIds.map((id) => <li><a href={categoryHub(id).url}>{site.categories[id].name}</a></li>)}</ul>
          </div>
          <div>
            <h2 class="footer-h">FlowExtract API</h2>
            <ul class="footer-list">
              <li><a href="/about.html">About</a></li>
              <li><a href="/contact.html">Contact</a></li>
              <li><a href="/privacy.html">Privacy</a></li>
              <li><a href={site.brand.storeProfile} rel="noopener">All actors on Apify</a></li>
            </ul>
          </div>
          <div>
            <h2 class="footer-h">Support</h2>
            <ul class="footer-list">
              <li><a href={`mailto:${site.brand.email}`}>{site.brand.email}</a></li>
              <li><a href={s.github} rel="noopener">GitHub</a></li>
              <li><a href={s.linkedin} rel="noopener">LinkedIn</a></li>
              <li><a href={s.x} rel="noopener">X</a></li>
              <li><a href={s.facebook} rel="noopener">Facebook</a></li>
              <li><a href={s.tiktok} rel="noopener">TikTok</a></li>
            </ul>
          </div>
        </div>
        <p class="footer-note">© {year} FlowExtract API. Apify is a trademark of Apify Technologies s.r.o.; site names belong to their owners.</p>
      </div>
    </footer>
    <script is:inline>
      // Cookie-free usage counts (privacy page "Clicks and errors"): which link/button was clicked on which page, and
      // browser errors, sent to our own Worker (/e → Analytics Engine). No cookie, no identifier, never what people type.
      // Read with: node scripts/site-stats.mjs [days]
      (function () {
        var sent = 0, errs = 0;
        function send(t, l, d) {
          if (sent > 60) return; sent++;
          try { var b = JSON.stringify({ t: t, p: location.pathname, l: String(l || '').slice(0, 96), d: String(d || '').slice(0, 160) });
            if (!(navigator.sendBeacon && navigator.sendBeacon('/e', new Blob([b], { type: 'text/plain' })))) fetch('/e', { method: 'POST', body: b, keepalive: true }); } catch (e) {}
        }
        window.feReport = function (label, detail) { if (errs++ < 5) send('ui_error', label, detail); };
        document.addEventListener('click', function (e) {
          var el = e.target.closest && e.target.closest('[data-track],a,button,summary');
          if (!el) return;
          var txt = (el.getAttribute('aria-label') || el.textContent || '').replace(/\s+/g, ' ').trim().slice(0, 50), l;
          if (el.dataset.track) l = el.dataset.track;
          else if (el.tagName === 'A') { var u = new URL(el.href, location.href); l = u.origin === location.origin ? (u.pathname.indexOf('/go/') === 0 ? 'store:' + u.pathname.slice(4) : 'link:' + u.pathname + u.hash) : 'out:' + u.hostname; }
          else if (el.tagName === 'SUMMARY') l = 'open:' + txt;
          else l = 'button:' + (el.dataset.demoId ? 'demo ' + el.dataset.demoId : txt);
          send('ui_click', l, el.tagName === 'A' ? txt : '');
        }, true);
        window.addEventListener('error', function (e) {
          var t = e.target;
          if (t && t !== window && t.closest && t.closest('.demo-card')) return; // scraped thumbnails that expired: not our error
          if (t && t !== window && (t.src || t.href)) window.feReport('resource ' + t.tagName.toLowerCase(), t.src || t.href);
          else window.feReport('js: ' + (e.message || 'error'), (e.filename || '').replace(location.origin, '') + ':' + (e.lineno || 0));
        }, true);
        window.addEventListener('unhandledrejection', function (e) { var r = e.reason; window.feReport('promise: ' + ((r && r.message) || String(r)).slice(0, 80), ''); });
      })();
    </script>
  </body>
</html>
