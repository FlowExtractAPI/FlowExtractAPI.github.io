---
import Base from '../../layouts/Base.astro';
import Explorer from '../../components/Explorer.astro';
import LiveDemo from '../../components/LiveDemo.astro';
import ActorIcon from '../../components/ActorIcon.astro';
import {
  actors, site, categoryHub, sourceHub, priceRows, priceSummary, priceShort, outputFields, inputFields, inputTitle,
  faqFor, related, softwareJsonLd, faqJsonLd, pricesFetchedAt,
} from '../../lib/site.js';

export function getStaticPaths() {
  return actors.map((a) => ({ params: { slug: a.pageSlug }, props: { a } }));
}
const { a } = Astro.props;
const cat = categoryHub(a.category);
const src = a.sourceHub && site.sourceHubs[a.sourceHub] ? sourceHub(a.sourceHub) : null;
const crumbs = [
  { name: 'Home', url: '/' },
  { name: site.categories[a.category].name, url: cat.url },
  ...(src ? [{ name: `${site.sourceHubs[a.sourceHub].name} scrapers`, url: src.url }] : []),
  { name: a.label, url: a.url },
];
const out = outputFields(a);
const inp = inputFields(a);
const OUT_SHOWN = 20;
const IN_SHOWN = 12;
const prices = priceRows(a);
const faq = faqFor(a);
const rel = related(a, 6);
const firstInput = inp.find((f) => f.required) || inp[0];
const hasExplorer = !!a.sample;
const toc = [
  ...(a.liveDemo ? [['try', 'Try it live']] : []),
  ...(hasExplorer ? [['data', 'Real results']] : []),
  ['how', 'How it works'], ['output', 'Data you get'], ['input', 'What you give it'], ['pricing', 'Pricing'],
  ...(a.officialApi ? [['official-api', 'Official API']] : []),
  ['uses', 'Use cases'], ['faq', 'Questions'], ['related', 'Related scrapers'],
];
// Real cost of the run behind the data table (Apify's own numbers from run.json), never estimated.
const run = a.sample && a.sample.run;
const realCost = run && typeof run.costUsd === 'number' ? `$${run.costUsd < 0.01 ? run.costUsd.toFixed(4) : run.costUsd.toFixed(3)}` : null;
---
<Base title={a.title} description={a.metaDescription} path={a.url} breadcrumbs={crumbs} jsonLd={[softwareJsonLd(a), faqJsonLd(faq)]} hideCrumbs>
  <div class="actor-head">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><ol>{crumbs.map((b, i) => <li>{i < crumbs.length - 1 ? <a href={b.url}>{b.name}</a> : <span aria-current="page">{b.name}</span>}</li>)}</ol></nav>
      <div class="ahead">
        <ActorIcon a={a} size={72} />
        <div>
          <p class="eyebrow" style="margin:0 0 6px">{a.source} · {site.categories[a.category].name}</p>
          <h1>{a.h1}</h1>
        </div>
      </div>
      <p class="lede">{a.intro}</p>
      <div class="chips">
        <span class="chip">{priceShort(a)}</span>
        {hasExplorer && <span class="chip">Real results below · run {a.sample.run.date}</span>}
        <span class="chip">JSON · CSV · Excel · API</span>
      </div>
      <div class="cta-row" style="margin-bottom:0">
        <a class="btn btn-primary" href={a.goUrl} rel="nofollow" target="_blank">Run it on Apify →</a>
        <a class="btn btn-ghost" href={hasExplorer ? '#data' : '#output'}>{hasExplorer ? 'See real results' : 'See the fields'}</a>
      </div>
    </div>
  </div>

  <div class="wrap actor-layout">
    <nav class="toc" aria-label="On this page"><ol>{toc.map(([id, t]) => <li><a href={`#${id}`}>{t}</a></li>)}</ol></nav>
    <div class="content">
      {a.liveDemo && <section style="padding-top:36px"><LiveDemo actor={a} /></section>}
      {hasExplorer && <section style="padding-top:36px"><Explorer actor={a} /></section>}

      <section id="how" aria-labelledby="how-h">
        <h2 id="how-h">How it works</h2>
        <ol class="steps">
          <li>Open <a href={a.goUrl} rel="nofollow" target="_blank">{a.label} on the Apify Store</a>{firstInput ? <> and fill in <b>{inputTitle(firstInput)}</b></> : null}.</li>
          <li>Click Start. The run collects the data on Apify's servers; you can close the tab.</li>
          <li>Download JSON, CSV or Excel, or read the results through the Apify API.</li>
        </ol>
      </section>

      <section id="output" aria-labelledby="output-h">
        <h2 id="output-h">Data you get</h2>
        {out.length > 0 ? (
          <>
            <p>Each record can carry up to {out.length} fields. The most useful ones:</p>
            <div class="table-wrap">
              <table>
                <thead><tr><th scope="col">Field</th><th scope="col">What it holds</th></tr></thead>
                <tbody>{out.slice(0, OUT_SHOWN).map((f) => <tr><td><code>{f.name}</code></td><td>{f.description || f.label || ''}{f.type ? <span class="muted small"> · {f.type}</span> : null}</td></tr>)}</tbody>
              </table>
            </div>
            {out.length > OUT_SHOWN && <details class="more"><summary>All {out.length} fields</summary><p class="mono small">{out.slice(OUT_SHOWN).map((f) => f.name).join(' · ')}</p></details>}
          </>
        ) : <p>See the output tab on the Apify Store for the full field list.</p>}
      </section>

      <section id="input" aria-labelledby="input-h">
        <h2 id="input-h">What you give it</h2>
        {inp.length > 0 ? (
          <>
            <div class="table-wrap">
              <table>
                <thead><tr><th scope="col">Setting</th><th scope="col">Type</th><th scope="col">Notes</th></tr></thead>
                <tbody>
                  {inp.slice(0, IN_SHOWN).map((f) => (
                    <tr>
                      <td>{inputTitle(f)}{f.required ? <b> (required)</b> : null}<br /><code class="small">{f.name}</code></td>
                      <td>{f.type}</td>
                      <td>{f.description}{f.options ? <span class="muted small"> Options: {f.options.join(', ')}.</span> : null}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            {inp.length > IN_SHOWN && <p class="muted small">Plus {inp.length - IN_SHOWN} more settings with defaults, listed on the Apify Store.</p>}
          </>
        ) : <p>See the input tab on the Apify Store.</p>}
      </section>

      <section id="pricing" aria-labelledby="pricing-h">
        <h2 id="pricing-h">Pricing</h2>
        <p>{priceSummary(a)}</p>
        {prices.length > 0 && (
          <div class="table-wrap">
            <table>
              <thead><tr><th scope="col">Charged for</th><th scope="col">Apify free plan</th><th scope="col">Lowest plan price</th></tr></thead>
              <tbody>{prices.map((p) => <tr><td>{p.title}{p.description ? <><br /><span class="muted small">{p.description}</span></> : null}</td><td>{p.free} <span class="muted small">{p.unit}</span></td><td>{p.lowest} <span class="muted small">{p.unit}</span></td></tr>)}</tbody>
            </table>
          </div>
        )}
        {realCost && <p class="note" style="margin-top:14px"><b>Real cost check:</b> the test run behind the table above ({run.date}) returned {run.itemCount} {run.itemCount === 1 ? 'result' : 'results'} and cost our test account {realCost} in total, on Apify's free plan{run.costNote ? <> ({run.costNote})</> : null}.</p>}
        <p class="muted small" style="margin-top:10px">Prices as listed on the Apify Store on {pricesFetchedAt}. The Store page always shows the current price.</p>
      </section>

      {a.officialApi && <section id="official-api" aria-labelledby="official-api-h">
        <h2 id="official-api-h">{a.source} official API vs this scraper</h2>
        <p>{a.officialApi}</p>
      </section>}

      <section id="uses" aria-labelledby="uses-h">
        <h2 id="uses-h">Use cases</h2>
        <ul class="uses">{a.useCases.map((u) => <li>{u}</li>)}</ul>
      </section>

      <section id="faq" class="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Questions</h2>
        {faq.map((f) => <><h3>{f.q}</h3><p>{f.a}</p></>)}
      </section>

      <section id="related" aria-labelledby="related-h">
        <h2 id="related-h">Related scrapers</h2>
        <ul class="related">{rel.map((r) => <li><a href={r.url}><ActorIcon a={r} size={30} /><span>{r.label}<small>{r.source}</small></span></a></li>)}</ul>
        <p>More in <a href={cat.url}>{site.categories[a.category].name.toLowerCase()} scrapers</a>{src ? <> and the <a href={src.url}>{site.sourceHubs[a.sourceHub].name} scraper guide</a></> : null}. Full documentation: <a href={a.goUrl} rel="nofollow" target="_blank">{a.label} on the Apify Store</a>.</p>
      </section>
    </div>
  </div>
</Base>
