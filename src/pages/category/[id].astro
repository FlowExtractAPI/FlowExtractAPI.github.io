---
import Base from '../../layouts/Base.astro';
import ActorCard from '../../components/ActorCard.astro';
import CatIcon from '../../components/CatIcon.astro';
import { site, categoryIds, categoryHub, actorsIn, sourceHub, BASE } from '../../lib/site.js';

export function getStaticPaths() {
  return categoryIds.map((id) => ({ params: { id }, props: { id } }));
}
const { id } = Astro.props;
const h = categoryHub(id);
const list = actorsIn(id);
const withData = list.filter((a) => a.sample).length;
const sources = [...new Set(list.map((a) => a.sourceHub).filter((s) => s && site.sourceHubs[s]))].map(sourceHub);
const others = categoryIds.filter((x) => x !== id);
const crumbs = [{ name: 'Home', url: '/' }, { name: site.categories[id].name, url: h.url }];
const itemList = {
  '@context': 'https://schema.org', '@type': 'ItemList', name: h.h1,
  itemListElement: list.map((a, i) => ({ '@type': 'ListItem', position: i + 1, url: BASE + a.url, name: a.label })),
};
---
<Base title={h.title} description={h.metaDescription} path={h.url} breadcrumbs={crumbs} jsonLd={[itemList]} hideCrumbs>
  <div class="actor-head">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><ol>{crumbs.map((b, i) => <li>{i < crumbs.length - 1 ? <a href={b.url}>{b.name}</a> : <span aria-current="page">{b.name}</span>}</li>)}</ol></nav>
      <div class="ahead">
        <span class="icon" style="width:72px;height:72px;display:grid;place-items:center;color:var(--slate)"><CatIcon id={id} size={34} /></span>
        <div><p class="eyebrow" style="margin:0 0 6px">{list.length} scrapers{withData ? ` · ${withData} with real results` : ''}</p><h1>{h.h1}</h1></div>
      </div>
      <p class="lede">{h.intro}</p>
      {sources.length > 0 && <p class="note">Working with one site? See the {sources.map((s, i) => <>{i ? ', ' : ''}<a href={s.url}>{site.sourceHubs[s.id].name} scraper guide</a></>)}: which tool to use for which job.</p>}
    </div>
  </div>
  <section aria-labelledby="list-h">
    <div class="wrap">
      <h2 id="list-h">{site.categories[id].name} scrapers</h2>
      <ul class="cards">{list.map((a) => <ActorCard a={a} />)}</ul>
    </div>
  </section>
  <section class="band" aria-labelledby="how-h">
    <div class="wrap">
      <h2 id="how-h">How these scrapers work</h2>
      <p class="lede">Each one is an actor on the Apify platform. You paste a link or a few search terms, start the run, and get the results as JSON, CSV or Excel, or through the Apify API. Apify runs the servers and bills usage; every account gets a monthly free credit to test with.</p>
    </div>
  </section>
  <section aria-labelledby="more-h">
    <div class="wrap">
      <h2 id="more-h">Other categories</h2>
      <div class="cats">{others.map((o) => <a class="cat" href={categoryHub(o).url}><span class="ic"><CatIcon id={o} /></span><strong>{site.categories[o].name} <span class="arr">→</span></strong><span class="count">{actorsIn(o).length} scrapers</span></a>)}</div>
    </div>
  </section>
</Base>
