---
import Base from '../../layouts/Base.astro';
import { site, hubs, actors, actorsFromSource, categoryHub, priceShort, priceSummary, faqJsonLd, BASE } from '../../lib/site.js';

export function getStaticPaths() {
  return hubs.filter((h) => h.kind === 'source').map((h) => ({ params: { id: h.id }, props: { h } }));
}
const { h } = Astro.props;
const list = actorsFromSource(h.id);
const bySlug = (s) => actors.find((a) => a.slug === s);
const cats = [...new Set(list.map((a) => a.category))];
const crumbs = [{ name: 'Home', url: '/' }, { name: site.categories[cats[0]].name, url: categoryHub(cats[0]).url }, { name: `${site.sourceHubs[h.id].name} scrapers`, url: h.url }];
const faq = h.faq || [];
const itemList = {
  '@context': 'https://schema.org', '@type': 'ItemList', name: h.h1,
  itemListElement: list.map((a, i) => ({ '@type': 'ListItem', position: i + 1, url: BASE + a.url, name: a.label })),
};
---
<Base title={h.title} description={h.metaDescription} path={h.url} breadcrumbs={crumbs} jsonLd={[itemList, ...(faq.length ? [faqJsonLd(faq)] : [])]}>
  <div class="wrap content">
    <header class="hero">
      <p class="eyebrow">{list.length} {site.sourceHubs[h.id].name} scrapers</p>
      <h1>{h.h1}</h1>
      <p class="lede">{h.intro}</p>
    </header>
    {h.chooser && (
      <section aria-labelledby="choose-h">
        <h2 id="choose-h">Which one do you need?</h2>
        <div class="table-wrap">
          <table>
            <thead><tr><th scope="col">You start from</th><th scope="col">You want</th><th scope="col">Use</th></tr></thead>
            <tbody>{h.chooser.map((r) => { const a = bySlug(r.slug); return <tr><td>{r.start}</td><td>{r.want}</td><td><a href={a.url}>{a.label}</a></td></tr>; })}</tbody>
          </table>
        </div>
      </section>
    )}
    <section aria-labelledby="tools-h">
      <h2 id="tools-h">The tools and what they cost</h2>
      {list.map((a) => (
        <article class="stat" style="margin-bottom:12px">
          <h3><a href={a.url}>{a.label}</a></h3>
          <p>{a.intro}</p>
          <p class="small muted">{priceSummary(a)}</p>
        </article>
      ))}
    </section>
    {faq.length > 0 && (
      <section class="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Questions</h2>
        {faq.map((f) => <><h3>{f.q}</h3><p>{f.a}</p></>)}
      </section>
    )}
    <p>More: <a href={categoryHub(cats[0]).url}>all {site.categories[cats[0]].name.toLowerCase()} scrapers</a>.</p>
  </div>
</Base>
